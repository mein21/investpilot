# Copy to .env and change every value marked CHANGE_ME.
# Never commit .env. The T-Invest token lives only on the backend.

APP_ENV=development
DEBUG=false
BASE_CURRENCY=RUB

# --- Local authentication -------------------------------------------------
AUTH_ENABLED=true
ADMIN_USERNAME=admin
# Used only to bootstrap the first local user. It is hashed with scrypt.
ADMIN_PASSWORD=CHANGE_ME_use_a_long_password
# Random >= 32 characters. Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME_random_session_secret_at_least_32_chars
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
# Cookie that remembers the selected T-Invest account for the local user.
ACCOUNT_COOKIE_NAME=investpilot_account
# Local login throttling per client address.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# --- Database -------------------------------------------------------------
# Development default. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://investpilot:CHANGE_ME@db:5432/investpilot
DATABASE_URL=sqlite:///./data/investpilot.db

# --- Screener -------------------------------------------------------------
# SQLite cache for the deterministic stock screener. The web page only reads
# the latest saved run; use the CLI or the cache-only button to recalculate.
SCREENER_DB_PATH=./data/screener.db
# Use the latest screen run for stock BUY candidates and 40% of buy score.
RECOMMENDATIONS_SCREENER_ENABLED=true
SCREENER_RATING_MAX_AGE_HOURS=72

# --- T-Invest integration -------------------------------------------------
# mock = deterministic local data, no network. rest = official REST API.
TINVEST_CLIENT=mock
# Never put a real token in this example file. Read-only token is enough for
# OBSERVE/RECOMMEND. Full-access token is needed only for order submission.
TINVEST_TOKEN=
TINVEST_SANDBOX=true
# Empty = derive from TINVEST_SANDBOX and the official documented endpoints.
TINVEST_BASE_URL=
TINVEST_APP_NAME=InvestPilotLocal
# Optional outbound proxy for restricted networks, e.g. http://127.0.0.1:10809
TINVEST_PROXY=
# Optional extra trusted CA bundle (PEM). Needed on hosts that lack the
# Russian Trusted Root CA, e.g. ./deploy/certs/russian_trusted_root_ca.pem
TINVEST_CA_BUNDLE=
TINVEST_TIMEOUT_SECONDS=30
TINVEST_MAX_RETRIES=2
TINVEST_OPERATIONS_DAYS=365
# Instrument classes to load for recommendations: shares,bonds,etfs,currencies,futures
UNIVERSE_KINDS=shares,etfs,currencies
# PAPER state persistence. Empty = data/<db-name>.mock-state.json next to the
# SQLite file; set an absolute path for a custom location.
MOCK_STATE_PATH=

# --- Safety / trading -----------------------------------------------------
# OBSERVE | RECOMMEND | PAPER | CONFIRM. AUTO exists in code but is forbidden.
TRADING_MODE=RECOMMEND
REAL_TRADING_ENABLED=false
MAX_ORDER_AMOUNT=50000
MAX_DAILY_ORDER_AMOUNT=100000
MAX_DAILY_ORDER_COUNT=10
EMERGENCY_STOP=false
QUOTE_MAX_AGE_SECONDS=300
MAX_PRICE_DEVIATION_PERCENT=5
COMMISSION_RATE=0.003
MIN_TRADE_AMOUNT=500
MIN_EXPECTED_CORRECTION_PERCENT=0.20
MAX_ISSUER_PERCENT=25
MAX_RECOMMENDATIONS=25
RECOMMENDATION_TTL_MINUTES=30

# --- Growth analysis ------------------------------------------------------
# Deterministic momentum/trend metrics from daily candles. No AI/ML.
GROWTH_ANALYSIS_ENABLED=true
# Asset classes analyzed for growth; bonds are intentionally excluded by default.
GROWTH_ASSET_CLASSES=STOCK,ETF
GROWTH_HISTORY_DAYS=365
# A metric is re-fetched after this many hours; recommendations accept it for
# up to GROWTH_METRIC_MAX_AGE_HOURS before falling back to a neutral score.
GROWTH_CACHE_HOURS=12
GROWTH_METRIC_MAX_AGE_HOURS=72
# Max candles lookups per scheduler tick / CLI run (API quota friendly).
GROWTH_SCAN_LIMIT=100
GROWTH_SCAN_INTERVAL_MINUTES=30

# --- Goals / risk defaults ------------------------------------------------
DEFAULT_MIN_CASH_RESERVE=50000
DEFAULT_RISK_PROFILE=BALANCED
# Liquidate reached goals to cash when the target date is this close.
GOAL_FUNDING_WINDOW_DAYS=30

# --- Scheduler / backups --------------------------------------------------
SCHEDULER_ENABLED=true
SYNC_INTERVAL_MINUTES=5
MARKET_DATA_INTERVAL_MINUTES=60
SNAPSHOT_INTERVAL_MINUTES=60
BACKUP_INTERVAL_HOURS=24
# Automatic universe refresh and recommendation generation. Orders are never
# submitted automatically; recommendations still require explicit confirmation.
UNIVERSE_AUTO_LOAD_ENABLED=true
UNIVERSE_AUTO_LOAD_INTERVAL_HOURS=24
RECOMMENDATIONS_AUTO_ENABLED=true
RECOMMENDATIONS_AUTO_INTERVAL_MINUTES=30
BACKUP_DIR=./backups
BACKUP_KEEP=7

# --- Demo ----------------------------------------------------------------
SEED_DEMO_DATA=true
